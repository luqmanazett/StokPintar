generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAJER
  GUDANG
  KASIR
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  VOID
  PURCHASE
  OPNAME
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum StockOpnameStatus {
  DRAFT
  FINALIZED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model User {
  id           Int             @id @default(autoincrement())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(KASIR)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  sales        Sale[]
  movements    StockMovement[]
  auditLogs    AuditLog[]
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreator")
  goodsReceipts  GoodsReceipt[]   @relation("GoodsReceiptCreator")
  stockOpnames   StockOpname[]    @relation("StockOpnameCreator")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, createdAt])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
  stockOpnames StockOpname[]
}

model Product {
  id         Int             @id @default(autoincrement())
  sku        String          @unique
  name       String
  categoryId Int
  category   Category        @relation(fields: [categoryId], references: [id])
  costPrice  Int
  sellPrice  Int
  minStock   Int             @default(5)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  movements  StockMovement[]
  saleItems  SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockOpnameItems StockOpnameItem[]
}

model StockMovement {
  id          Int          @id @default(autoincrement())
  productId   Int
  product     Product      @relation(fields: [productId], references: [id])
  type        MovementType
  change      Int
  note        String?
  createdById Int
  createdBy   User         @relation(fields: [createdById], references: [id])
  saleId      Int?
  sale        Sale?        @relation(fields: [saleId], references: [id])
  goodsReceiptId Int?
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  stockOpnameId Int?
  stockOpname StockOpname? @relation(fields: [stockOpnameId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([productId])
}

model Supplier {
  id            Int             @id @default(autoincrement())
  name          String
  phone         String?
  address       String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          Int                @id @default(autoincrement())
  orderNumber String             @unique
  supplierId  Int
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  createdById Int
  createdBy   User               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  orderedAt   DateTime?
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]

  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product       @relation(fields: [productId], references: [id])
  qtyOrdered      Int
  qtyReceived     Int           @default(0)
  unitCost        Int
  receiptItems    GoodsReceiptItem[]

  @@unique([purchaseOrderId, productId])
}

model GoodsReceipt {
  id              Int               @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  createdById     Int
  createdBy       User              @relation("GoodsReceiptCreator", fields: [createdById], references: [id])
  note            String?
  createdAt       DateTime          @default(now())
  items           GoodsReceiptItem[]
  movements       StockMovement[]
}

model GoodsReceiptItem {
  id                  Int              @id @default(autoincrement())
  goodsReceiptId      Int
  goodsReceipt        GoodsReceipt     @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  quantity            Int

  @@unique([goodsReceiptId, purchaseOrderItemId])
}

model StockOpname {
  id           Int               @id @default(autoincrement())
  opnameNumber String            @unique
  status       StockOpnameStatus @default(DRAFT)
  notes        String?
  categoryId   Int?
  category     Category?         @relation(fields: [categoryId], references: [id])
  createdById  Int
  createdBy    User              @relation("StockOpnameCreator", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())
  finalizedAt  DateTime?
  items        StockOpnameItem[]
  movements    StockMovement[]

  @@index([status, createdAt])
}

model StockOpnameItem {
  id             Int         @id @default(autoincrement())
  stockOpnameId  Int
  stockOpname    StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product     @relation(fields: [productId], references: [id])
  systemQty      Int
  countedQty     Int?
  difference     Int?
  unitCostAtOpen Int

  @@unique([stockOpnameId, productId])
}

model Sale {
  id            Int           @id @default(autoincrement())
  cashierId     Int
  cashier       User          @relation(fields: [cashierId], references: [id])
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  createdAt     DateTime      @default(now())
  items         SaleItem[]
  movements     StockMovement[]

  @@index([createdAt])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  unitCost  Int
}